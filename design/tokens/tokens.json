{
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#F2ECE3",
      "$description": "Page background"
    },
    "surface": {
      "$type": "color",
      "$value": "#E8DFD2",
      "$description": "Raised panels, product image ground"
    },
    "field": {
      "$type": "color",
      "$value": "#F7F2EA",
      "$description": "Input field fill"
    },
    "text": {
      "default": {
        "$type": "color",
        "$value": "#2E211A",
        "$description": "Text"
      },
      "muted": {
        "$type": "color",
        "$value": "#6A584A",
        "$description": "Secondary text"
      },
      "onAccent": {
        "$type": "color",
        "$value": "#F7F2EA",
        "$description": "Text on clay and on images"
      }
    },
    "line": {
      "$type": "color",
      "$value": "#D3C4B1",
      "$description": "Dividers only"
    },
    "accent": {
      "default": {
        "$type": "color",
        "$value": "#8E4A2C",
        "$description": "Clay. Primary button fill, small accents"
      },
      "hover": {
        "$type": "color",
        "$value": "#733A22",
        "$description": "Primary button hover"
      }
    },
    "control": {
      "$type": "color",
      "$value": "#6A584A",
      "$description": "1px borders of inputs and unselected options"
    },
    "focus": {
      "default": {
        "$type": "color",
        "$value": "#2E211A",
        "$description": "2px focus outline, offset 3px"
      },
      "onImage": {
        "$type": "color",
        "$value": "#F7F2EA",
        "$description": "Focus outline over images and the footer button on dark"
      }
    },
    "disabled": {
      "bg": {
        "$type": "color",
        "$value": "#E8DFD2"
      },
      "text": {
        "$type": "color",
        "$value": "#8C7B6C"
      }
    },
    "state": {
      "error": {
        "$type": "color",
        "$value": "#9E2A1E",
        "$description": "Error text and field border, always with an icon and message"
      },
      "success": {
        "$type": "color",
        "$value": "#4C5E3A",
        "$description": "Confirmation states"
      }
    },
    "footer": {
      "bg": {
        "$type": "color",
        "$value": "#3A2A20",
        "$description": "Deep panel"
      },
      "text": {
        "$type": "color",
        "$value": "#F2ECE3"
      },
      "muted": {
        "$type": "color",
        "$value": "#B9A99A",
        "$description": "Footer secondary text"
      },
      "accent": {
        "$type": "color",
        "$value": "#E8B89A",
        "$description": "Footer link hover"
      },
      "button": {
        "bg": {
          "$type": "color",
          "$value": "#F2ECE3",
          "$description": "Footer button fill"
        },
        "text": {
          "$type": "color",
          "$value": "#2E211A"
        },
        "hover": {
          "$type": "color",
          "$value": "#E8DFD2",
          "$description": "Hover fill used on the components board; not yet recorded in visual-system.md"
        }
      }
    },
    "scrim": {
      "$type": "color",
      "$value": "rgba(46, 33, 26, 0.4)",
      "$description": "Behind the cart drawer and header panels"
    },
    "image": {
      "scrim": {
        "$type": "color",
        "$value": "rgba(46, 33, 26, 0.94)",
        "$description": "Warm umber scrim base at the bottom edge of images"
      }
    },
    "logo": {
      "tile": {
        "$type": "color",
        "$value": "#3A2A20"
      },
      "tileReversed": {
        "$type": "color",
        "$value": "#2E211A"
      },
      "light": {
        "$type": "color",
        "$value": "#F2ECE3"
      },
      "floor": {
        "$type": "color",
        "$value": "#8E4A2C"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Newsreader",
          "Georgia",
          "serif"
        ],
        "fontWeight": 300,
        "fontSize": "112px",
        "lineHeight": 1.0,
        "letterSpacing": "-0.02em"
      },
      "$extensions": {
        "kanlungan.fontSize": {
          "desktop": "112px",
          "mobile": "52px"
        }
      },
      "$description": "Hero heading"
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Newsreader",
          "Georgia",
          "serif"
        ],
        "fontWeight": 300,
        "fontSize": "56px",
        "lineHeight": 1.05,
        "letterSpacing": "-0.02em"
      },
      "$extensions": {
        "kanlungan.fontSize": {
          "desktop": "56px",
          "mobile": "36px"
        }
      },
      "$description": "Section headings, product name"
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Newsreader",
          "Georgia",
          "serif"
        ],
        "fontWeight": 300,
        "fontSize": "44px",
        "lineHeight": 1.15,
        "letterSpacing": "-0.015em"
      },
      "$extensions": {
        "kanlungan.fontSize": {
          "desktop": "44px",
          "mobile": "30px"
        }
      },
      "$description": "Statement, closing heading"
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Newsreader",
          "Georgia",
          "serif"
        ],
        "fontWeight": 300,
        "fontSize": "30px",
        "lineHeight": 1.2,
        "letterSpacing": "0em"
      },
      "$extensions": {
        "kanlungan.fontSize": {
          "desktop": "30px",
          "mobile": "24px"
        }
      },
      "$description": "Price, project names (italic)"
    },
    "h4": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Newsreader",
          "Georgia",
          "serif"
        ],
        "fontWeight": 400,
        "fontSize": "24px",
        "lineHeight": 1.3,
        "letterSpacing": "0em"
      },
      "$extensions": {
        "kanlungan.fontSize": {
          "desktop": "24px",
          "mobile": "20px"
        }
      },
      "$description": "Service titles, subsections"
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Newsreader",
          "Georgia",
          "serif"
        ],
        "fontWeight": 400,
        "fontSize": "20px",
        "lineHeight": 1.3,
        "letterSpacing": "0em"
      },
      "$extensions": {
        "kanlungan.fontSize": {
          "desktop": "20px",
          "mobile": "18px"
        }
      },
      "$description": "Product card name, collection name"
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Hanken Grotesk",
          "system-ui",
          "sans-serif"
        ],
        "fontWeight": 400,
        "fontSize": "17px",
        "lineHeight": 1.6,
        "letterSpacing": "0em"
      },
      "$extensions": {
        "kanlungan.fontSize": {
          "desktop": "17px",
          "mobile": "17px"
        }
      },
      "$description": "Running text"
    },
    "ui": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Hanken Grotesk",
          "system-ui",
          "sans-serif"
        ],
        "fontWeight": 500,
        "fontSize": "15px",
        "lineHeight": 1.4,
        "letterSpacing": "0em"
      },
      "$extensions": {
        "kanlungan.fontSize": {
          "desktop": "15px",
          "mobile": "15px"
        }
      },
      "$description": "Buttons, navigation, options"
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Hanken Grotesk",
          "system-ui",
          "sans-serif"
        ],
        "fontWeight": 400,
        "fontSize": "14px",
        "lineHeight": 1.5,
        "letterSpacing": "0em"
      },
      "$extensions": {
        "kanlungan.fontSize": {
          "desktop": "14px",
          "mobile": "14px"
        }
      },
      "$description": "Meta, availability, footer"
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Hanken Grotesk",
          "system-ui",
          "sans-serif"
        ],
        "fontWeight": 500,
        "fontSize": "12px",
        "lineHeight": 1.4,
        "letterSpacing": "0.08em"
      },
      "$extensions": {
        "kanlungan.fontSize": {
          "desktop": "12px",
          "mobile": "12px"
        }
      },
      "$description": "Labels, captions"
    }
  },
  "spacing": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Added in the design system refinement; already in use"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    },
    "9": {
      "$type": "dimension",
      "$value": "96px"
    },
    "10": {
      "$type": "dimension",
      "$value": "128px"
    },
    "11": {
      "$type": "dimension",
      "$value": "160px"
    }
  },
  "radius": {
    "base": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "breakpoint": {
    "tablet": {
      "$type": "dimension",
      "$value": "768px"
    },
    "desktop": {
      "$type": "dimension",
      "$value": "1280px"
    },
    "maxContent": {
      "$type": "dimension",
      "$value": "1440px"
    }
  },
  "grid": {
    "mobile": {
      "columns": {
        "$type": "number",
        "$value": 4
      },
      "margin": {
        "$type": "dimension",
        "$value": "20px"
      },
      "gutter": {
        "$type": "dimension",
        "$value": "16px"
      },
      "range": {
        "$type": "string",
        "$value": "under 768px"
      }
    },
    "tablet": {
      "columns": {
        "$type": "number",
        "$value": 8
      },
      "margin": {
        "$type": "dimension",
        "$value": "40px"
      },
      "gutter": {
        "$type": "dimension",
        "$value": "20px"
      },
      "range": {
        "$type": "string",
        "$value": "768px to 1279px"
      }
    },
    "desktop": {
      "columns": {
        "$type": "number",
        "$value": 12
      },
      "margin": {
        "$type": "dimension",
        "$value": "64px"
      },
      "gutter": {
        "$type": "dimension",
        "$value": "24px"
      },
      "range": {
        "$type": "string",
        "$value": "1280px and up"
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "200ms",
        "$description": "Color, border, background"
      },
      "base": {
        "$type": "duration",
        "$value": "300ms",
        "$description": "Small transforms"
      },
      "slow": {
        "$type": "duration",
        "$value": "400ms",
        "$description": "Image brightness, drawer and panel enter"
      },
      "ambient": {
        "$type": "duration",
        "$value": "12s",
        "$description": "Moving light, alternate, infinite"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.25,
          0.1,
          0.25,
          1
        ],
        "$description": "ease"
      },
      "ambient": {
        "$type": "cubicBezier",
        "$value": [
          0.42,
          0,
          0.58,
          1
        ],
        "$description": "ease-in-out"
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": [
          0.22,
          0.61,
          0.36,
          1
        ]
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.55,
          0,
          1,
          0.45
        ],
        "$description": "Used at 200ms"
      }
    }
  }
}